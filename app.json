{
  "expo": {
    "name": "expense_offline",
    "slug": "expense_offline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logog.png",
    "scheme": "expenseoffline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logog.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0aa4b8",
        "foregroundImage": "./assets/images/logog.png"
        // "backgroundImage": "./assets/images/android-icon-background.png",
        // "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mhdabdulkaderexpo.expense_offline"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logog.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0aa4b8",
          "image": "./assets/images/splash-screen.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
